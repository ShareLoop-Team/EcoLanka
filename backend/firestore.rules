rules_version = '2';

// Shareloop – STARTER Firestore rules (Phase 1, Infra / Dulum)
// FREE SPARK PLAN version: no Cloud Functions, so the app itself writes
// counters and notifications. These rules make sure it can only write
// what it is allowed to. Rumanga (Security) owns hardening in Phase 2/3.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() { return signedIn() && userDoc().role == 'admin'; }
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }
    // counter may stay the same or go up by exactly 1
    function unchangedOrPlusOne(field) {
      return request.resource.data.get(field, 0) == resource.data.get(field, 0) ||
             request.resource.data.get(field, 0) == resource.data.get(field, 0) + 1;
    }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if signedIn();
      // users cannot make themselves admin
      allow create: if isSelf(uid) && request.resource.data.role in ['donor', 'requester', 'both'];
      allow update: if (isSelf(uid) && unchanged('role') && unchanged('points') &&
                        unchanged('badges') && unchanged('isBanned') &&
                        unchangedOrPlusOne('donationCount') &&
                        unchangedOrPlusOne('requestCount'))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- categories (read-only for app) ----------
    match /categories/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- items ----------
    match /items/{itemId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.donorId == request.auth.uid
                    && request.resource.data.status == 'available'
                    && request.resource.data.images.size() <= 5;
      allow update: if (signedIn() && resource.data.donorId == request.auth.uid && unchanged('donorId'))
                    || isAdmin()
                    // any signed-in user may bump requestCount by 1 when they send a request
                    || (signedIn() && onlyChanges(['requestCount']) &&
                        request.resource.data.requestCount == resource.data.get('requestCount', 0) + 1);
      allow delete: if (signedIn() && resource.data.donorId == request.auth.uid) || isAdmin();
    }

    // ---------- requests ----------
    match /requests/{reqId} {
      function item(id) { return get(/databases/$(database)/documents/items/$(id)).data; }

      allow read: if signedIn() &&
        (resource.data.requesterId == request.auth.uid ||
         resource.data.donorId == request.auth.uid || isAdmin());
      allow create: if signedIn() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.donorId != request.auth.uid &&
        // donorId must really be the item's owner, and item must be available
        item(request.resource.data.itemId).donorId == request.resource.data.donorId &&
        item(request.resource.data.itemId).status == 'available';
      // donor: accepted / rejected / completed · requester: cancelled
      allow update: if signedIn() &&
        unchanged('requesterId') && unchanged('donorId') && unchanged('itemId') &&
        ((resource.data.donorId == request.auth.uid &&
            request.resource.data.status in ['pending', 'accepted', 'rejected', 'completed']) ||
         (resource.data.requesterId == request.auth.uid &&
            request.resource.data.status in ['pending', 'cancelled']) ||
         isAdmin());
      allow delete: if isAdmin();
    }

    // ---------- reviews ----------
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.reviewerId == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // ---------- reports ----------
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ---------- notifications (written by the app) ----------
    // The sender must be one side of the request and the recipient the other side.
    // getAfter() lets the request and its notification be written in one batch.
    match /notifications/{nId} {
      function isRequestPair(reqId, fromUid, toUid) {
        let r = getAfter(/databases/$(database)/documents/requests/$(reqId)).data;
        return (r.requesterId == fromUid && r.donorId == toUid) ||
               (r.donorId == fromUid && r.requesterId == toUid);
      }

      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      // recipient may only mark as read
      allow update: if signedIn() && resource.data.userId == request.auth.uid
                    && onlyChanges(['read']);
      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.userId != request.auth.uid &&
        request.resource.data.read == false &&
        request.resource.data.type in ['new_request', 'request_accepted', 'request_rejected',
                                       'request_cancelled', 'request_completed'] &&
        isRequestPair(request.resource.data.requestId, request.auth.uid, request.resource.data.userId);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
