rules_version = '2';

// Shareloop – STARTER Storage rules (Phase 1, Infra)
// Images only, max 5 MB. Rumanga extends with stricter validation in Phase 3.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    function underSize() { return request.resource.size < 5 * 1024 * 1024; }

    match /users/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && isImage() && underSize();
    }

    match /items/{itemId}/{fileName} {
      allow read: if signedIn();
      // ownership of the item is checked in Firestore rules; here we require auth + valid image
      allow create: if signedIn() && isImage() && underSize();
      allow delete: if signedIn();
    }

    match /reports/{reportId}/{fileName} {
      allow create: if signedIn() && isImage() && underSize();
      allow read: if false; // admins view via console / Admin SDK
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
